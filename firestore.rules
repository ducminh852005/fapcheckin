rules_version = '2';

// Client SDK bị chặn hoàn toàn. Backend truy cập Firestore bằng Admin SDK
// (Cloud Functions / server), Admin SDK bỏ qua rules này.
// Chỉ nới lỏng khi app/web đọc Firestore trực tiếp, và phải kiểm tra
// request.auth + vai trò (users.role) cho từng collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
