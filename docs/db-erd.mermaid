erDiagram
    USER_INVITES ||--o| USERS : "tạo hồ sơ ở lần đăng nhập đầu (khớp email)"
    USERS ||--o{ CLASSES : "dạy (teacherMemberCode)"
    SUBJECTS ||--o{ CLASSES : "subjectCode"
    TIME_SLOTS ||--|{ SLOTS : "timeSlotId"
    SLOTS ||--o{ CLASSES : "slotCode mặc định"
    CLASSES ||--o{ ENROLLMENTS : "có"
    USERS ||--o{ ENROLLMENTS : "SV ghi danh (rollNumber)"
    CLASSES ||--o{ CLASS_SCHEDULES : "buổi ngoài lịch"
    CLASSES ||--o{ SESSIONS : "phiên điểm danh"
    SESSIONS ||--o{ ATTENDANCE_RECORDS : "ghi nhận"
    USERS ||--o{ ATTENDANCE_RECORDS : "SV điểm danh (rollNumber)"
    USERS ||--o{ REQUESTS : "gửi đơn (authorUid)"
    USERS ||--o{ ANNOUNCEMENTS : "admin phát hành"

    USERS {
        string uid PK "docId = Firebase Auth uid"
        string memberCode "khóa sở hữu của GV; = rollNumber với SV"
        string fullName
        string email
        string role "user (SV) | staff (GV) | admin"
        string rollNumber "chỉ SV"
        boolean active "false = khóa tài khoản"
        timestamp createdAt
    }

    USER_INVITES {
        string email PK "docId = email viết thường"
        string role "user | staff | admin"
        string memberCode
        string fullName
        string rollNumber "chỉ SV"
    }

    SUBJECTS {
        string subjectCode PK "PRN232, PRM393, SWD392"
        string subjectName
        number credits
    }

    TIME_SLOTS {
        string timeSlotId PK "A-1, A-2, P-1, P-2"
        string period "Morning | Afternoon"
        number slotInPeriod "1 | 2"
        number daySlotNo "A-1:1 A-2:2 P-1:3 P-2:4"
        string startTime "HH:mm"
        string endTime "HH:mm"
    }

    SLOTS {
        string slotCode PK "A1..A6, P1..P6"
        string timeSlotId FK
        array weekdays "vd A1 -> [2,5]"
    }

    CLASSES {
        string classCode PK "vd PRN232_SE1917"
        string subjectCode FK
        string subjectName "denormalized từ subjects"
        number credits
        string room
        number studentCount
        string teacherMemberCode "rỗng = chưa có GV (GV import TKB để nhận lớp)"
        string slotCode FK
    }

    ENROLLMENTS {
        string id PK "docId = classCode_rollNumber"
        string classCode FK
        string rollNumber FK
        string teacherMemberCode "denormalized từ classes (rules + truy vấn của GV)"
        string fullName "denormalized"
        string email "denormalized"
    }

    CLASS_SCHEDULES {
        string scheduleId PK "docId = teacherMemberCode_requestId (idempotent)"
        string requestId
        string teacherMemberCode
        string classCode FK
        string scheduleDate "yyyy-MM-dd"
        string slotCode FK
        string room
        string lessonType "makeup | workshop | review"
        string teachingMethod "onCampus"
        string note "tối đa 2000 ký tự"
        string status "scheduled | cancelled"
        timestamp createdAt
    }

    SESSIONS {
        string sessionId PK
        string classCode FK
        string teacherMemberCode "khóa sở hữu"
        string sessionDate "yyyy-MM-dd"
        string slotCode FK
        string sessionStatus "open | closed | expired | cancelled"
        string qrSecret "xoay mỗi 60 giây; SV KHÔNG đọc được"
        boolean ipCheck "GV tích khi mở phiên; mặc định false"
        string teacherIp "chỉ lưu khi ipCheck = true"
        timestamp createdAt
    }

    ATTENDANCE_RECORDS {
        string recordId PK "docId = sessionId_rollNumber (chống trùng)"
        string sessionId FK
        string rollNumber FK
        string classCode "denormalized từ sessions"
        string teacherMemberCode "denormalized từ sessions"
        string qrToken "chỉ có ở bản ghi SV tự điểm danh"
        timestamp checkinTime "serverTimestamp; trống với Absent"
        string status "Present | Late | Absent | ManualByGV | Unchecked"
        string networkVerificationResult "Match | Skipped | Manual | AutoAbsent | Mismatch (dữ liệu cũ)"
        string ipAddress "IP công khai của SV, rỗng nếu phiên không kiểm tra IP"
        string note "tối đa 2000 ký tự"
        timestamp updatedAt
        string updatedBy "memberCode GV"
        boolean syncedToFap "mặc định false"
    }

    REQUESTS {
        string requestId PK
        string type "attendance_fix | leave"
        string authorUid FK
        string authorMemberCode
        string sessionId "tùy chọn"
        string classCode "tùy chọn"
        string reason "1..2000 ký tự"
        string status "pending | approved | rejected (chỉ admin đổi)"
        timestamp createdAt
        string resolvedBy
        timestamp resolvedAt
        string adminNote
    }

    ANNOUNCEMENTS {
        string id PK
        string audience "all | staff | user"
        string title
        string body
        timestamp createdAt
    }
