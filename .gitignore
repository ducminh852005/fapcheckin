# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
**/flutter/ephemeral/
**/.plugin_symlinks/
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
**/build/

# Accidental Flutter scaffold generated at the monorepo root.
# The maintained Flutter application lives under mobile/.
/android/
/ios/
/linux/
/macos/
/windows/

# Local OAuth credentials used for desktop builds (đặt trong mobile/)
desktop_oauth.json
desktop_oauth.local.json
**/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/mobile/android/app/debug
/mobile/android/app/profile
/mobile/android/app/release

# Widget Preview related
.widget_preview/

docs/assets/*

# Firebase
.firebase/
firebase-debug.log*
firestore-debug.log
ui-debug.log
*-debug.log

# Node (firebase/, firebase/functions/, e2e_test/)
node_modules/

# Python virtual environments (e2e_test/)
.venv/
.pytest_cache/

# Local Android E2E configuration and raw UI evidence may contain account data.
e2e_test/config.local.json
e2e_test/.env.local
e2e_test/results/**/*.xml
e2e_test/results/manual-run-*/
e2e_test/results/smoke-*/
e2e_test/results/local-*/

# Evidence written by older QA runner versions before the output-path fix.
/results/

# Package nội bộ không cần khóa phiên bản riêng
packages/core/pubspec.lock


# GCP service account keys
*-[0-9a-f]*.json.key
fapcheckin-*-[0-9a-f]*.json
*service-account*.json
