{
  "name": "fapcheckin-firebase",
  "private": true,
  "type": "module",
  "description": "Security rules, tests và script vận hành Firebase cho FAP Check-in",
  "scripts": {
    "test": "firebase emulators:exec --project demo-fapcheckin --only firestore,storage \"node --test --test-concurrency=1 tests/*.test.mjs\"",
    "test:rules": "node --test --test-concurrency=1 tests/*.test.mjs",
    "emulators": "firebase emulators:start --project demo-fapcheckin",
    "seed:admin": "node scripts/seed-admin.mjs",
    "seed:reference": "node scripts/seed-reference.mjs",
    "seed:support": "node scripts/seed-support.mjs",
    "set:work-info": "node scripts/set-work-info.mjs",
    "migrate:legacy": "node scripts/migrate-legacy.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0"
  }
}
